<UserControl x:Class="Bibliotekssystem.Admin.Listviewmedia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bibliotekssystem.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="0">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock Text="Stina's Library" FontSize="30" FontWeight="UltraBold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Width="400" Margin="20" Height="30" FontSize="20"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Click="StartSideBtn" Width="80" Height="40" Content="Startsida"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Click="Logoutbt" Width="80" Height="40" Content="Logga ut"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1">
            <TextBlock Text="Media Lista" FontSize="25" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,0">
                <Button Click="CreateBookBtn" Content="Lägg till Bok" Width="90" Margin="0,0,10,0" Padding="5"/>
                <Button Click="CreateAudioBookBtn" Content="Lägg till judbok" Width="95" Margin="0,0,10,0" Padding="5"/>
                <Button Click="CreateMovieBtn" Content="Lägg till Film" Width="100" Padding="5"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400" MaxWidth="800">
                <ListBox x:Name="MediaDisplayInfo" MinHeight="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Width="150" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding Authors}" Width="150" Margin="0,0,15,0"/>
                                <TextBlock Text="Lånad: -" Width="70" Margin="0,0,15,0"/>
                                <TextBlock Text="Försenad: -" Width="80" Margin="0,0,15,0"/>
                                <TextBlock Text="Avskriven: -" Width="80" Margin="0,0,15,0"/>
                                <Button Click="DeleteMediaBtn_Click" Content="Ta Bort" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>            