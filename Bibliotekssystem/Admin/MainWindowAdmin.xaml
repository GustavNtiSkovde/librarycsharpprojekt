<UserControl x:Class="Bibliotekssystem.Admin.MainWindowAdmin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bibliotekssystem.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Background="White">
        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Admin Panel" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button x:Name="StartSideBtn" Content="Media Lista" Width="150" Height="35" Margin="5" Click="StartSideBtn_Click"/>
            <Button Content="Hantera Konton" Width="150" Height="35" Margin="5" Click="AccountsBtn_Click"/>
            <Button x:Name="Logoutbt" Content="Logga ut" Width="150" Height="35" Margin="5" Click="Logoutbt_Click"/>
        </StackPanel>
    </Grid>
</UserControl>